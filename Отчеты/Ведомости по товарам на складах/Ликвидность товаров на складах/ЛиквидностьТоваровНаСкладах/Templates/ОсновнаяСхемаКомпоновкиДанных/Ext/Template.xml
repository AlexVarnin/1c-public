////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Остатки.Склад КАК Склад,
	Остатки.Номенклатура КАК Номенклатура,
	СУММА(Остатки.ВНаличииОстаток) КАК Количество
ПОМЕСТИТЬ ВТ_Остатки
ИЗ
	РегистрНакопления.ТоварыНаСкладах.Остатки(&amp;ДатаОтчета, {(Склад).* КАК Склад, (Номенклатура).* КАК Номенклатура}) КАК Остатки
ГДЕ
	Остатки.Склад.Наименование В ("К-МАРКЕТ Санкт-Петербург", "Центральный Москва")

СГРУППИРОВАТЬ ПО
	Остатки.Склад,
	Остатки.Номенклатура

ИМЕЮЩИЕ
	СУММА(Остатки.ВНаличииОстаток) &lt;&gt; 0

ИНДЕКСИРОВАТЬ ПО
	Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Цены.Номенклатура КАК Номенклатура,
	ВЫБОР
		КОГДА Цены.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
				ИЛИ ЕСТЬNULL(Цены.Упаковка.Числитель, 0) = 0
			ТОГДА Цены.Цена
		ИНАЧЕ Цены.Цена * ЕСТЬNULL(Цены.Упаковка.Знаменатель, 1) / Цены.Упаковка.Числитель
	КОНЕЦ КАК Цена
ПОМЕСТИТЬ ВТ_Цены
ИЗ
	РегистрСведений.ЦеныНоменклатуры25.СрезПоследних(
			&amp;ДатаОтчета,
			ВидЦены В
					(ВЫБРАТЬ
						Т.ВидЦены
					ИЗ
						ВТ_ВидЦены КАК Т)
				И Номенклатура В
					(ВЫБРАТЬ РАЗЛИЧНЫЕ
						Т.Номенклатура
					ИЗ
						ВТ_Остатки КАК Т)) КАК Цены

ИНДЕКСИРОВАТЬ ПО
	Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ПередачаТовары.Номенклатура КАК Номенклатура,
	МАКСИМУМ(ПередачаТовары.Ссылка.Дата) КАК ДатаПередачи
ПОМЕСТИТЬ ВТ_ДатыПередач
ИЗ
	Документ.ПередачаТоваровХранителю.Товары КАК ПередачаТовары
ГДЕ
	ПередачаТовары.Ссылка.Проведен
	И ПередачаТовары.Ссылка.Дата &lt; &amp;ДатаОтчета
	И ПередачаТовары.Номенклатура В
			(ВЫБРАТЬ РАЗЛИЧНЫЕ
				Т.Номенклатура
			ИЗ
				ВТ_Остатки КАК Т)

СГРУППИРОВАТЬ ПО
	ПередачаТовары.Номенклатура

ИНДЕКСИРОВАТЬ ПО
	Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Даты.Номенклатура КАК Номенклатура,
	МАКСИМУМ(ПередачаТовары.Ссылка.Партнер) КАК Партнер
ПОМЕСТИТЬ ВТ_ПартнерыПередач
ИЗ
	ВТ_ДатыПередач КАК Даты
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПередачаТоваровХранителю.Товары КАК ПередачаТовары
		ПО Даты.Номенклатура = ПередачаТовары.Номенклатура
			И Даты.ДатаПередачи = ПередачаТовары.Ссылка.Дата
			И (ПередачаТовары.Ссылка.Проведен)

СГРУППИРОВАТЬ ПО
	Даты.Номенклатура

ИНДЕКСИРОВАТЬ ПО
	Номенклатура
;


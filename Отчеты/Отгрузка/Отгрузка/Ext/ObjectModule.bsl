
Функция СведенияОВнешнейОбработке() Экспорт
	
	Сведения = Новый Структура;
	Сведения.Вставить("Вид", "ДополнительныйОтчет");
	Сведения.Вставить("Наименование", "Проверка отгрузки на ТСД");
	Сведения.Вставить("Версия", "1.0.0");
	Сведения.Вставить("БезопасныйРежим", Истина);
	Сведения.Вставить("Информация", "Проверки отгрузки заказов по данным ТСД.");
	Сведения.Вставить("Назначение", Новый Массив);
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	Команда = Команды.Добавить();
	Команда.Представление = Сведения.Наименование;
	Команда.Идентификатор = "ОтгрузкиПроверкиТСД";
	Команда.Использование = "ОткрытиеФормы";
	Сведения.Вставить("Команды", Команды);
	
	Возврат Сведения;
	
КонецФункции

Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт

	Настройки.События.ПередЗагрузкойНастроекВКомпоновщик = Истина;
	
КонецПроцедуры

Процедура ПередЗагрузкойНастроекВКомпоновщик(Контекст, КлючСхемы, КлючВарианта, НовыеНастройкиКД, НовыеПользовательскиеНастройкиКД) Экспорт	

	Схема = ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Набор = Схема.НаборыДанных[0];
	
	ПолеПоставки = Набор.Поля.Найти("Поставка"); 
	ПолеПоставки.ТипЗначения = Новый ОписаниеТипов("ДокументСсылка.топ_ПоставкаFBS");  
	
	ПолеМаркетплейса = Набор.Поля.Найти("Маркетплейс"); 
	ПолеМаркетплейса.ТипЗначения = Новый ОписаниеТипов("ПеречислениеСсылка.топ_ТорговыеПлощадки");
	
	ОтчетыСервер.ПодключитьСхему(ЭтотОбъект, Контекст, Схема, КлючСхемы);
	
КонецПроцедуры

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь; 
	
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	Период = Настройки.ПараметрыДанных.Элементы.Найти(
		Новый ПараметрКомпоновкиДанных("СтандартныйПериод")).Значение;
	НачалоПериода = Период.ДатаНачала;
	КонецПериода  = Период.ДатаОкончания;
		
	Если НачалоДня(НачалоПериода) > КонецДня(КонецПериода) Тогда
		ВызватьИсключение "Начало периода проверки позже окончания периода.";
	КонецЕсли;

	ВнешниеНаборы = Новый Структура("ДанныеПроверок",
		ПолучитьДанныеПроверок(НачалоДня(НачалоПериода), КонецДня(КонецПериода)));
	Схема = СхемаКомпоновкиДанных;
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Макет = КомпоновщикМакета.Выполнить(Схема, Настройки, ДанныеРасшифровки);
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(Макет, ВнешниеНаборы, ДанныеРасшифровки);
	ДокументРезультат.Очистить();
	Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	Вывод.УстановитьДокумент(ДокументРезультат);
	Вывод.Вывести(Процессор);
	
КонецПроцедуры

Функция ПолучитьДанныеПроверок(НачалоПериода, КонецПериода)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Проверки.Заказ КАК ЗаказУИД,
	|	Проверки.Поставка КАК ПоставкаУИД,
	|	Проверки.ДатаПроверки КАК ДатаПроверки,
	|	Проверки.Пользователь КАК Пользователь,
	|	Проверки.Устройство КАК НомерТСД,
	|	ЗНАЧЕНИЕ(Документ.топ_ЗаказТорговойПлощадки.ПустаяСсылка) КАК ЗаказСсылка,
	|	ЗНАЧЕНИЕ(Документ.топ_ПоставкаFBS.ПустаяСсылка) КАК ПоставкаСсылка,
	|	ИСТИНА КАК ЕстьВТСД
	|ИЗ
	|	РегистрСведений.кор_ПроверкаОтгрузкиЗаказов КАК Проверки
	|ГДЕ
	|	Проверки.ДатаПроверки МЕЖДУ &НачалоПериода И &КонецПериода
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	"""",
	|	"""",
	|	ДАТАВРЕМЯ(1,1,1),
	|	"""",
	|	"""",
	|	топ_ПоставкаFBSЗаказы.ЗаказТорговойПлощадки,
	|	топ_ПоставкаFBSЗаказы.Ссылка,
	|	ЛОЖЬ КАК ЕстьВТСД
	|ИЗ
	|	Документ.топ_ПоставкаFBS.Заказы КАК топ_ПоставкаFBSЗаказы
	|ГДЕ
	|	топ_ПоставкаFBSЗаказы.Ссылка.Дата МЕЖДУ &НачалоПериода И &КонецПериода";
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	
	Проверки = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Проверка Из Проверки Цикл
		Если Проверка.ЕстьВТСД Тогда
			Проверка.ЗаказСсылка = СсылкаПоУИД(Документы.топ_ЗаказТорговойПлощадки, Проверка.ЗаказУИД);
			Проверка.ПоставкаСсылка = СсылкаПоУИД(Документы.топ_ПоставкаFBS, Проверка.ПоставкаУИД); 
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Проверки", Проверки);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Данные.ЗаказУИД КАК ЗаказУИД,
	|	Данные.ПоставкаУИД КАК ПоставкаУИД,
	|	Данные.ДатаПроверки КАК ДатаПроверки,
	|	Данные.Пользователь КАК Пользователь,
	|	Данные.НомерТСД КАК НомерТСД,
	|	Данные.ЗаказСсылка КАК ЗаказСсылка,
	|	Данные.ПоставкаСсылка КАК ПоставкаСсылка
	|ПОМЕСТИТЬ ВТ_ИсходныеПроверки
	|ИЗ
	|	&Проверки КАК Данные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(Данные.ДатаПроверки) КАК ДатаПроверки,
	|	МАКСИМУМ(Данные.Пользователь) КАК Пользователь,
	|	МАКСИМУМ(Данные.НомерТСД) КАК НомерТСД,
	|	Данные.ЗаказСсылка КАК ЗаказСсылка,
	|	Данные.ПоставкаСсылка КАК ПоставкаСсылка
	|ПОМЕСТИТЬ ВТ_Проверки
	|ИЗ
	|	ВТ_ИсходныеПроверки КАК Данные
	|
	|СГРУППИРОВАТЬ ПО
	|	Данные.ПоставкаСсылка,
	|	Данные.ЗаказСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ЗаказыТП.Ссылка, ЗНАЧЕНИЕ(Документ.топ_ЗаказТорговойПлощадки.ПустаяСсылка)) КАК ЗаказТорговойПлощадки,
	|	ЕСТЬNULL(ЗаказыТП.НомерЗаказа, """") КАК НомерЗаказа,
	|	ЕСТЬNULL(Поставки.Ссылка, ЗНАЧЕНИЕ(Документ.топ_ПоставкаFBS.ПустаяСсылка)) КАК Поставка,
	|	ЕСТЬNULL(Поставки.НомерПоставки, """") КАК НомерПоставки,
	|	Проверки.ДатаПроверки КАК ДатаПроверки,
	|	Проверки.Пользователь КАК Пользователь,
	|	Проверки.НомерТСД КАК НомерТСД,
	|	ВЫБОР
	|		КОГДА Поставки.Ссылка ЕСТЬ NULL
	|			ТОГДА ЕСТЬNULL(ЗаказыТП.ЛичныйКабинет.ТорговаяПлощадка, ЗНАЧЕНИЕ(Перечисление.топ_ТорговыеПлощадки.ПустаяСсылка))
	|		ИНАЧЕ Поставки.ЛичныйКабинет.ТорговаяПлощадка
	|	КОНЕЦ КАК Маркетплейс,
	|	ВЫБОР
	|		КОГДА ЗаказыТП.Ссылка ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЗаказНайден,
	|	ВЫБОР
	|		КОГДА Поставки.Ссылка ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ПоставкаНайдена
	|ИЗ
	|	ВТ_Проверки КАК Проверки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.топ_ЗаказТорговойПлощадки КАК ЗаказыТП
	|		ПО (Проверки.ЗаказСсылка = ЗаказыТП.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.топ_ПоставкаFBS КАК Поставки
	|		ПО (Проверки.ПоставкаСсылка = Поставки.Ссылка)";
	
	Возврат Запрос.Выполнить().Выгрузить(); 
	
КонецФункции

Функция СсылкаПоУИД(МенеджерДокумента, ЗначениеУИД)
	
	Если ПустаяСтрока(ЗначениеУИД) Тогда
		Возврат МенеджерДокумента.ПустаяСсылка();
	КонецЕсли;
	Попытка
		УИД = Новый УникальныйИдентификатор(ЗначениеУИД);
	Исключение
		Возврат МенеджерДокумента.ПустаяСсылка();
	КонецПопытки;
	
	Возврат МенеджерДокумента.ПолучитьСсылку(УИД); 
	
КонецФункции

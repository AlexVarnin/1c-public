		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ ПЕРВЫЕ 1
	ВидыЦен.Ссылка КАК ВидЦены
ПОМЕСТИТЬ ВТ_ВидЦены
ИЗ
	Справочник.ВидыЦен КАК ВидыЦен
ГДЕ
	ВидыЦен.Наименование = "Закупочная цена"
	И НЕ ВидыЦен.ПометкаУдаления
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Остатки.Склад КАК Склад,
	Остатки.Номенклатура КАК Номенклатура,
	Остатки.Характеристика КАК Характеристика,
	СУММА(Остатки.ВНаличииОстаток) КАК Количество
ПОМЕСТИТЬ ВТ_Остатки
ИЗ
	РегистрНакопления.ТоварыНаСкладах.Остатки(&amp;ДатаОтчета, {(Склад).* КАК Склад, (Номенклатура).* КАК Номенклатура, (Характеристика).* КАК Характеристика}) КАК Остатки
ГДЕ
	Остатки.Склад.Наименование В ("К-МАРКЕТ Санкт-Петербург", "Центральный Москва")

СГРУППИРОВАТЬ ПО
	Остатки.Склад,
	Остатки.Номенклатура,
	Остатки.Характеристика

ИМЕЮЩИЕ
	СУММА(Остатки.ВНаличииОстаток) &lt;&gt; 0

ИНДЕКСИРОВАТЬ ПО
	Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Цены.Номенклатура КАК Номенклатура,
	Цены.ХарактеристикаЦО КАК ХарактеристикаЦО,
	ВЫБОР
		КОГДА Цены.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
				ИЛИ ЕСТЬNULL(Цены.Упаковка.Числитель, 0) = 0
			ТОГДА Цены.Цена
		ИНАЧЕ Цены.Цена * ЕСТЬNULL(Цены.Упаковка.Знаменатель, 1) / Цены.Упаковка.Числитель
	КОНЕЦ КАК Цена
ПОМЕСТИТЬ ВТ_Цены
ИЗ
	РегистрСведений.ЦеныНоменклатуры25.СрезПоследних(
			&amp;ДатаОтчета,
			ВидЦены В
					(ВЫБРАТЬ
						Т.ВидЦены
					ИЗ
						ВТ_ВидЦены КАК Т)
				И Номенклатура В
					(ВЫБРАТЬ РАЗЛИЧНЫЕ
						Т.Номенклатура
					ИЗ
						ВТ_Остатки КАК Т)
				И СерияЦО = ЗНАЧЕНИЕ(Справочник.СерииНоменклатурыДляЦенообразования.ПустаяСсылка)
				И УпаковкаЦО = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)) КАК Цены

ИНДЕКСИРОВАТЬ ПО
	Номенклатура,
	ХарактеристикаЦО
;

////////////////////////////////////////////////////////////////////////////////
// Заказы маркетплейсов (БИТ.УМ, все схемы работы), текущий статус которых — «Доставлен».
// Дата продажи — первая запись «Доставлен» в истории статусов заказа.
ВЫБРАТЬ
	ИсторияСтатусов.ЗаказТорговойПлощадки КАК ЗаказТорговойПлощадки,
	МИНИМУМ(ИсторияСтатусов.Период) КАК ДатаДоставки
ПОМЕСТИТЬ ВТ_ДоставленныеЗаказы
ИЗ
	РегистрСведений.топ_СтатусыЗаказовТорговойПлощадки КАК ИсторияСтатусов
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.топ_СтатусыЗаказовТорговойПлощадки.СрезПоследних(&amp;ДатаОтчета, ) КАК ТекущиеСтатусы
		ПО ИсторияСтатусов.ЗаказТорговойПлощадки = ТекущиеСтатусы.ЗаказТорговойПлощадки
ГДЕ
	ИсторияСтатусов.УнифицированныйСтатус.Наименование = "Доставлен"
	И ТекущиеСтатусы.УнифицированныйСтатус.Наименование = "Доставлен"
	И ИсторияСтатусов.Период &lt; &amp;ДатаОтчета

СГРУППИРОВАТЬ ПО
	ИсторияСтатусов.ЗаказТорговойПлощадки

ИНДЕКСИРОВАТЬ ПО
	ЗаказТорговойПлощадки
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Соответствие.Номенклатура КАК Номенклатура,
	МАКСИМУМ(Доставленные.ДатаДоставки) КАК ДатаПоследнейПродажи
ПОМЕСТИТЬ ВТ_Продажи
ИЗ
	ВТ_ДоставленныеЗаказы КАК Доставленные
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.топ_ЗаказТорговойПлощадки.Товары КАК ТоварыЗаказа
		ПО Доставленные.ЗаказТорговойПлощадки = ТоварыЗаказа.Ссылка
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.топ_СоответствиеТоваров КАК Соответствие
		ПО ТоварыЗаказа.Товар = Соответствие.Товар
ГДЕ
	НЕ ТоварыЗаказа.Ссылка.ПометкаУдаления
	И ЕСТЬNULL(ТоварыЗаказа.УнифицированныйСтатус.Наименование, "") &lt;&gt; "Отменен"
	И Соответствие.Номенклатура В
			(ВЫБРАТЬ РАЗЛИЧНЫЕ
				Т.Номенклатура
			ИЗ
				ВТ_Остатки КАК Т)

СГРУППИРОВАТЬ ПО
	Соответствие.Номенклатура

ИНДЕКСИРОВАТЬ ПО
	Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
// Партнер последней передачи хранителю (логика v3)
ВЫБРАТЬ
	ПередачаТовары.Номенклатура КАК Номенклатура,
	МАКСИМУМ(ПередачаТовары.Ссылка.Дата) КАК ДатаПередачи
ПОМЕСТИТЬ ВТ_ДатыПередач
ИЗ
	Документ.ПередачаТоваровХранителю.Товары КАК ПередачаТовары
ГДЕ
	ПередачаТовары.Ссылка.Проведен
	И ПередачаТовары.Ссылка.Дата &lt; &amp;ДатаОтчета
	И ПередачаТовары.Номенклатура В
			(ВЫБРАТЬ РАЗЛИЧНЫЕ
				Т.Номенклатура
			ИЗ
				ВТ_Остатки КАК Т)

СГРУППИРОВАТЬ ПО
	ПередачаТовары.Номенклатура

ИНДЕКСИРОВАТЬ ПО
	Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Даты.Номенклатура КАК Номенклатура,
	МАКСИМУМ(ПередачаТовары.Ссылка.Партнер) КАК Партнер
ПОМЕСТИТЬ ВТ_ПартнерыПередач
ИЗ
	ВТ_ДатыПередач КАК Даты
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПередачаТоваровХранителю.Товары КАК ПередачаТовары
		ПО Даты.Номенклатура = ПередачаТовары.Номенклатура
			И Даты.ДатаПередачи = ПередачаТовары.Ссылка.Дата
			И (ПередачаТовары.Ссылка.Проведен)

СГРУППИРОВАТЬ ПО
	Даты.Номенклатура

ИНДЕКСИРОВАТЬ ПО
	Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Остатки.Склад КАК Склад,
	Остатки.Номенклатура КАК Номенклатура,
	Остатки.Характеристика КАК Характеристика,
	Остатки.Количество КАК Количество,
	ЕСТЬNULL(ЦеныПоХарактеристике.Цена, ЦеныБезХарактеристики.Цена) КАК Цена,
	Остатки.Количество * ЕСТЬNULL(ЕСТЬNULL(ЦеныПоХарактеристике.Цена, ЦеныБезХарактеристики.Цена), 0) КАК Сумма,
	Продажи.ДатаПоследнейПродажи КАК ДатаПоследнейПродажи,
	РАЗНОСТЬДАТ(Продажи.ДатаПоследнейПродажи, ДОБАВИТЬКДАТЕ(&amp;ДатаОтчета, СЕКУНДА, -1), ДЕНЬ) КАК ДнейСПоследнейПродажи,
	ВЫБОР
		КОГДА Продажи.ДатаПоследнейПродажи ЕСТЬ NULL
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК НетПродажНаМП,
	ПартнерыПередач.Партнер КАК ПартнерПоследнейПередачи
ИЗ
	ВТ_Остатки КАК Остатки
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Цены КАК ЦеныПоХарактеристике
		ПО Остатки.Номенклатура = ЦеныПоХарактеристике.Номенклатура
			И (ЦеныПоХарактеристике.ХарактеристикаЦО &lt;&gt; ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатурыДляЦенообразования.ПустаяСсылка))
			И Остатки.Характеристика.ХарактеристикаНоменклатурыДляЦенообразования = ЦеныПоХарактеристике.ХарактеристикаЦО
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Цены КАК ЦеныБезХарактеристики
		ПО Остатки.Номенклатура = ЦеныБезХарактеристики.Номенклатура
			И (ЦеныБезХарактеристики.ХарактеристикаЦО = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатурыДляЦенообразования.ПустаяСсылка))
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Продажи КАК Продажи
		ПО Остатки.Номенклатура = Продажи.Номенклатура
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПартнерыПередач КАК ПартнерыПередач
		ПО Остатки.Номенклатура = ПартнерыПередач.Номенклатура</query>
	</dataSet>
	<totalField>
		<dataPath>Количество</dataPath>
		<expression>Сумма(Количество)</expression>
	</totalField>
	<totalField>
		<dataPath>Сумма</dataPath>
		<expression>Сумма(Сумма)</expression>
	</totalField>
	<parameter>
		<name>ДатаОтчета</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Остатки на</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>

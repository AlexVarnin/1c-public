		<field xsi:type="DataSetFieldField">
			<dataPath>ПартнерПоследнейПередачи</dataPath>
			<field>ПартнерПоследнейПередачи</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Партнер (последняя передача хранителю)</v8:content>
